<section class="location" id="localisation">
  <div class="container location__grid">
    <div class="location__content" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="location__text">{{ section.settings.text }}</p>

      <ul class="location__details">
        {%- if section.settings.address != blank -%}
          <li>
            {% render 'icon', name: 'map-pin' %}
            <span>{{ section.settings.address }}</span>
          </li>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <li>
            {% render 'icon', name: 'clock' %}
            <span>{{ section.settings.hours }}</span>
          </li>
        {%- endif -%}
        {%- if settings.shop_phone != blank -%}
          <li>
            {% render 'icon', name: 'phone' %}
            <a href="tel:{{ settings.shop_phone | remove: ' ' }}">{{ settings.shop_phone }}</a>
          </li>
        {%- endif -%}
      </ul>

      <a href="{{ section.settings.directions_link | default: '#' }}" class="button button--outline" target="_blank" rel="noopener">
        Itinéraire {% render 'icon', name: 'arrow-right', size: 16 %}
      </a>
    </div>

    <div class="location__map" data-reveal>
      {%- if section.settings.map_embed_url != blank -%}
        <iframe
          src="{{ section.settings.map_embed_url }}"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="{{ section.settings.heading | escape }}"
        ></iframe>
      {%- else -%}
        <div class="location__map-placeholder">
          {% render 'icon', name: 'map-pin', size: 32 %}
          <p>Ajoutez l'URL d'intégration Google Maps dans les réglages de cette section.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Localisation",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Où nous trouver" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Basée à Carnoules, dans le Var" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Retrouvez-nous à Carnoules, au cœur du Var. Le retrait et la restitution de votre commande s'effectuent uniquement sur place, sur rendez-vous. Une visite de notre atelier reste possible pour découvrir nos pièces avant de réserver." },
    { "type": "text", "id": "address", "label": "Adresse", "default": "Carnoules, 83660 (Var)" },
    { "type": "text", "id": "hours", "label": "Horaires", "default": "Du mardi au dimanche, 10h – 18h30, sur rendez-vous" },
    { "type": "url", "id": "directions_link", "label": "Lien vers l'itinéraire" },
    {
      "type": "text",
      "id": "map_embed_url",
      "label": "URL d'intégration Google Maps",
      "info": "Google Maps > Partager > Intégrer une carte > copier le lien du src de l'iframe."
    }
  ],
  "presets": [{ "name": "Localisation" }]
}
{% endschema %}
