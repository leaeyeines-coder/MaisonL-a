<section class="story" id="histoire">
  <div class="container story__grid">
    <div class="story__media" data-reveal>
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 900 }} 900w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(max-width: 749px) 100vw, 45vw"
          alt="{{ section.settings.image.alt | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="lazy"
        >
      {%- else -%}
        <div class="story__placeholder"></div>
      {%- endif -%}
      <span class="story__frame" aria-hidden="true"></span>
    </div>

    <div class="story__content" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="story__text rte">{{ section.settings.text }}</div>

      {%- if section.settings.signature != blank -%}
        <p class="story__signature">{{ section.settings.signature }}</p>
      {%- endif -%}

      <div class="story__stats">
        {%- for block in section.blocks -%}
          {%- if block.type == 'stat' -%}
            <div class="story__stat" {{ block.shopify_attributes }}>
              <span class="story__stat-number">{{ block.settings.number }}</span>
              <span class="story__stat-label">{{ block.settings.label }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Notre histoire",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Notre histoire" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Née d'une passion pour les tables qui racontent une histoire" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Maison Palma est née d'un constat simple : la plus belle vaisselle ne devrait pas dormir toute l'année dans un placard. Depuis notre atelier, nous sélectionnons pièce après pièce une collection de vaisselle, verrerie et couverts pensée pour sublimer les tables de mariage, entre élégance intemporelle et matières nobles.</p><p>Chaque formule est composée avec la même exigence : des matières qui se marient à toutes les décorations, du beige lin au vert sauge, et un service pensé pour que le jour J, vous n'ayez à penser à rien.</p>"
    },
    { "type": "text", "id": "signature", "label": "Signature", "default": "L'équipe Maison Palma" }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Chiffre clé",
      "settings": [
        { "type": "text", "id": "number", "label": "Chiffre", "default": "500+" },
        { "type": "text", "id": "label", "label": "Libellé", "default": "mariages accompagnés" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Notre histoire",
      "blocks": [
        { "type": "stat", "settings": { "number": "500+", "label": "mariages accompagnés" } },
        { "type": "stat", "settings": { "number": "3", "label": "formules sur mesure" } },
        { "type": "stat", "settings": { "number": "10 ans", "label": "d'expérience" } }
      ]
    }
  ]
}
{% endschema %}
