<section class="a-la-carte" id="a-la-carte">
  <div class="container">
    <div class="a-la-carte__head" data-reveal>
      <div class="section-heading">
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2>{{ section.settings.heading }}</h2>
        <p class="section-heading__text">{{ section.settings.text }}</p>
      </div>
      <a href="{{ section.settings.all_link | default: '#' }}" class="button button--outline">
        Voir toute la collection
      </a>
    </div>

    <div class="a-la-carte__strip-wrap">
      <ul class="a-la-carte__strip" data-reveal>
        {%- for block in section.blocks -%}
          {%- if block.type == 'categorie' -%}
            {%- assign cat_collection = collections[block.settings.collection] -%}
            <li class="category-tile" {{ block.shopify_attributes }}>
              <a href="{{ cat_collection.url | default: '#' }}">
                <div class="category-tile__media" style="max-width:150px;aspect-ratio:1;margin-inline:auto;">
                  {%- if block.settings.image -%}
                    <img src="{{ block.settings.image | image_url: width: 300 }}" alt="{{ block.settings.label }}" width="300" height="300" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block;">
                  {%- elsif cat_collection.featured_image -%}
                    <img src="{{ cat_collection.featured_image | image_url: width: 300 }}" alt="{{ block.settings.label }}" width="300" height="300" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block;">
                  {%- else -%}
                    <div class="category-tile__placeholder">{% render 'icon', name: 'leaf', size: 28 %}</div>
                  {%- endif -%}
                </div>
                <div class="category-tile__label">
                  <span>{{ block.settings.label }}</span>
                  {%- if cat_collection != blank -%}
                    <small>{{ cat_collection.products_count }} pièces</small>
                  {%- endif -%}
                </div>
                <span class="category-tile__discover">Découvrir {% render 'icon', name: 'arrow-right', size: 13 %}</span>
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "À la carte",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "À la carte" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Composez votre table, pièce par pièce" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Fourchettes, couteaux, verres, assiettes, décoration : piochez librement dans chaque catégorie, en dehors ou en complément d'une formule." },
    { "type": "url", "id": "all_link", "label": "Lien \"voir tout\"" }
  ],
  "blocks": [
    {
      "type": "categorie",
      "name": "Catégorie",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection liée" },
        { "type": "image_picker", "id": "image", "label": "Image (remplace la photo de la collection)" },
        { "type": "text", "id": "label", "label": "Nom de la catégorie", "default": "Fourchettes" }
      ]
    }
  ],
  "presets": [
    {
      "name": "À la carte",
      "blocks": [
        { "type": "categorie", "settings": { "label": "Fourchettes" } },
        { "type": "categorie", "settings": { "label": "Couteaux" } },
        { "type": "categorie", "settings": { "label": "Verres" } },
        { "type": "categorie", "settings": { "label": "Assiettes" } },
        { "type": "categorie", "settings": { "label": "Décoration" } }
      ]
    }
  ]
}
{% endschema %}
