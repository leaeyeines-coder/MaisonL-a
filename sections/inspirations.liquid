<section class="inspirations" id="inspirations">
  <div class="container">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-heading__text">{{ section.settings.text }}</p>
    </div>
  </div>

  <div class="inspirations__slider-wrap">
    <button type="button" class="inspirations__nav inspirations__nav--prev" data-slider-prev aria-label="Thème précédent">
      {% render 'icon', name: 'arrow-right', size: 18 %}
    </button>

    <ul class="inspirations__slider" data-slider data-reveal>
      {%- for block in section.blocks -%}
        {%- if block.type == 'theme' -%}
          {%- assign gallery_lines = block.settings.gallery | newline_to_br | split: '<br />' -%}
          {%- capture images_json -%}[{%- if block.settings.image -%}{"src":"{{ block.settings.image | image_url: width: 1200 }}","alt":"{{ block.settings.name | escape }}"}{%- endif -%}{%- if block.settings.image_2 -%},{"src":"{{ block.settings.image_2 | image_url: width: 1200 }}","alt":"{{ block.settings.name | escape }}"}{%- endif -%}{%- if block.settings.image_3 -%},{"src":"{{ block.settings.image_3 | image_url: width: 1200 }}","alt":"{{ block.settings.name | escape }}"}{%- endif -%}{%- if block.settings.image_4 -%},{"src":"{{ block.settings.image_4 | image_url: width: 1200 }}","alt":"{{ block.settings.name | escape }}"}{%- endif -%}{%- for line in gallery_lines -%}{%- assign url = line | strip -%}{%- if url != blank -%},{"src":"{{ url }}","alt":"{{ block.settings.name | escape }}"}{%- endif -%}{%- endfor -%}]{%- endcapture -%}
          {%- assign first_gallery_url = gallery_lines | first | strip -%}
          {%- assign gallery_page_url = routes.root_url | append: 'pages/' | append: block.settings.name | handleize -%}
          <li class="inspiration-card" {{ block.shopify_attributes }}>
            {%- if first_gallery_url != blank -%}
              <a href="{{ gallery_page_url }}" class="inspiration-card__media" aria-label="Voir les idées de décoration {{ block.settings.name | escape }}">
                <img src="{{ first_gallery_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
                <span class="inspiration-card__hint">Voir les idées {% render 'icon', name: 'arrow-right', size: 12 %}</span>
              </a>
            {%- else -%}
              <button type="button" class="inspiration-card__media" data-inspiration-open
                data-name="{{ block.settings.name | escape }}"
                data-text="{{ block.settings.text | escape }}"
                data-devis-href="{{ routes.root_url }}?style={{ block.settings.name | url_encode }}#devis"
                data-images='{{ images_json }}'
                aria-label="Voir les idées de décoration {{ block.settings.name | escape }}">
                {%- if block.settings.image -%}
                  <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.name | escape }}" width="700" height="{{ 700 | divided_by: block.settings.image.aspect_ratio | default: 500 }}" loading="lazy">
                {%- else -%}
                  <div class="inspiration-card__placeholder">{% render 'icon', name: 'sparkle', size: 30 %}</div>
                {%- endif -%}
                <span class="inspiration-card__hint">Voir les idées {% render 'icon', name: 'arrow-right', size: 12 %}</span>
              </button>
            {%- endif -%}
            <div class="inspiration-card__body">
              <h3>{{ block.settings.name }}</h3>
              <p>{{ block.settings.text }}</p>
              <a href="{{ routes.root_url }}?style={{ block.settings.name | url_encode }}#devis" class="button button--outline-light button--small" data-style-link data-style-name="{{ block.settings.name | escape }}">
                Demander un devis {% render 'icon', name: 'arrow-right', size: 14 %}
              </a>
            </div>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <button type="button" class="inspirations__nav inspirations__nav--next" data-slider-next aria-label="Thème suivant">
      {% render 'icon', name: 'arrow-right', size: 18 %}
    </button>
  </div>

  <div class="inspiration-modal" data-inspiration-modal aria-hidden="true">
    <div class="inspiration-modal__overlay" data-inspiration-close></div>
    <div class="inspiration-modal__panel" role="dialog" aria-modal="true" aria-label="Idées de décoration">
      <button type="button" class="icon-button inspiration-modal__close" data-inspiration-close aria-label="Fermer">
        {% render 'icon', name: 'close' %}
      </button>
      <div class="inspiration-modal__gallery" data-inspiration-gallery></div>
      <div class="inspiration-modal__body">
        <h3 data-inspiration-title></h3>
        <p data-inspiration-text></p>
        <a href="#devis" class="button button--primary button--full" data-inspiration-devis>
          Demander un devis {% render 'icon', name: 'arrow-right', size: 14 %}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Inspirations",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Inspirations" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trouvez le thème de votre table" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "Une ambiance vous parle plus qu'une autre ? Dites-le-nous et nous vous préparons un devis assorti à votre univers." }
  ],
  "blocks": [
    {
      "type": "theme",
      "name": "Thème",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo principale" },
        { "type": "image_picker", "id": "image_2", "label": "Photo supplémentaire 1" },
        { "type": "image_picker", "id": "image_3", "label": "Photo supplémentaire 2" },
        { "type": "image_picker", "id": "image_4", "label": "Photo supplémentaire 3" },
        { "type": "textarea", "id": "gallery", "label": "Galerie technique (réservé)", "info": "URLs d'images ajoutées par le développeur, une par ligne. Ne pas modifier." },
        { "type": "text", "id": "name", "label": "Nom du thème", "default": "Dolce Vita" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Citronniers, terracotta et douceur italienne pour une table estivale et ensoleillée." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Inspirations",
      "blocks": [
        { "type": "theme", "settings": { "name": "Dolce Vita", "text": "Citronniers, terracotta et douceur italienne pour une table estivale et ensoleillée." } },
        { "type": "theme", "settings": { "name": "Coloré", "text": "Des teintes vives et joyeuses pour une réception pleine de peps et de bonne humeur." } },
        { "type": "theme", "settings": { "name": "Champêtre", "text": "Bois brut, lin naturel et fleurs des champs pour une table simple et chaleureuse." } },
        { "type": "theme", "settings": { "name": "Chic", "text": "Noir, blanc et touches dorées pour une réception sobre et élégante." } }
      ]
    }
  ]
}
{% endschema %}
