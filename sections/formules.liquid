<section class="formules" id="formules">
  <div class="container">
    <div class="section-heading" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <p class="section-heading__text">{{ section.settings.text }}</p>
    </div>

    <div class="formules__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'formule' -%}
          <div class="formule-card{% if block.settings.featured %} formule-card--featured{% endif %}" data-reveal {{ block.shopify_attributes }}>
            {%- if block.settings.featured -%}
              <span class="formule-card__badge">{{ block.settings.badge_text | default: 'Le plus choisi' }}</span>
            {%- endif -%}

            <div class="formule-card__media">
              {%- if block.settings.image -%}
                <img src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.image.alt | escape }}" width="700" height="{{ 700 | divided_by: block.settings.image.aspect_ratio | default: 500 }}" loading="lazy">
              {%- else -%}
                <div class="formule-card__placeholder"></div>
              {%- endif -%}
            </div>

            <div class="formule-card__body">
              <h3>{{ block.settings.name }}</h3>
              <p class="formule-card__price">
                <span>{{ block.settings.price }}</span>
                <small>{{ block.settings.price_unit | default: '/ pièce, dès' }}</small>
              </p>

              <a href="{{ block.settings.collection_link | default: '#a-la-carte' }}" class="button {% if block.settings.featured %}button--primary{% else %}button--outline{% endif %} button--full">
                {{ block.settings.button_label | default: 'Découvrir la formule' }}
              </a>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <p class="formules__footnote" data-reveal>
      Toutes les formules sont personnalisables : mélangez les pièces, les finitions et les quantités selon votre table.
      <a href="#devis">Besoin d'une prestation sur mesure ?</a>
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Nos formules",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Nos formules" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Trois façons de dresser une table inoubliable" },
    { "type": "textarea", "id": "text", "label": "Texte", "default": "De l'essentiel épuré à l'exception la plus raffinée, choisissez la formule qui correspond à votre style et composez librement vos pièces à la carte." }
  ],
  "blocks": [
    {
      "type": "formule",
      "name": "Formule",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "name", "label": "Nom", "default": "Emma" },
        { "type": "text", "id": "price", "label": "Prix", "default": "1,90 €" },
        { "type": "text", "id": "price_unit", "label": "Unité de prix", "default": "/ pièce, dès" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "L'essentiel, dans des lignes épurées et intemporelles." },
        {
          "type": "textarea",
          "id": "included",
          "label": "Éléments inclus (un par ligne)",
          "default": "Assiettes en porcelaine blanche\nCouverts inox brossé\nVerres à eau et à vin\nServiettes en coton"
        },
        { "type": "checkbox", "id": "featured", "label": "Mettre en avant", "default": false },
        { "type": "text", "id": "badge_text", "label": "Texte du badge (si mis en avant)", "default": "Le plus choisi" },
        { "type": "url", "id": "collection_link", "label": "Lien vers la collection" },
        { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Découvrir la formule" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Nos formules",
      "blocks": [
        {
          "type": "formule",
          "settings": {
            "name": "Emma",
            "price": "À partir de 0,30 €",
            "price_unit": "/ pièce",
            "description": "L'essentiel, dans des lignes épurées et intemporelles.",
            "included": "Fourchettes\nCouteaux\nCuillères à dessert\nCuillères à entrée\nVerres à eau\nVerres à vin\nVerres à champagne\nFlûtes à champagne",
            "button_label": "Découvrir la formule Emma"
          }
        },
        {
          "type": "formule",
          "settings": {
            "name": "Lucie",
            "price": "3,20 €",
            "description": "Des matières nobles et des finitions dorées pour une table raffinée.",
            "included": "Assiettes bord doré\nCouverts dorés\nVerrerie taillée\nSous-assiettes en rotin\nServiettes en lin",
            "featured": true,
            "badge_text": "Le plus choisi",
            "button_label": "Découvrir la formule Lucie"
          }
        },
        {
          "type": "formule",
          "settings": {
            "name": "Lena",
            "price": "5,50 €",
            "description": "L'excellence absolue : porcelaine fine, cristal et pièces d'exception.",
            "included": "Porcelaine fine peinte main\nCouverts argentés\nCristal soufflé bouche\nChemins de table en soie\nDécoration florale assortie",
            "button_label": "Découvrir la formule Lena"
          }
        }
      ]
    }
  ]
}
{% endschema %}
