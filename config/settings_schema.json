[
  {
    "name": "theme_info",
    "theme_name": "Maison Palma",
    "theme_author": "Maison Palma",
    "theme_version": "1.0.0",
    "theme_documentation_url": "https://github.com/leaeyeines-coder/MaisonL-a",
    "theme_support_email": "contact@maison-palma.fr"
  },
  {
    "name": "Couleurs",
    "settings": [
      {
        "type": "header",
        "content": "Palette ivoire & mocha"
      },
      {
        "type": "color",
        "id": "color_background",
        "label": "Fond principal (ivoire)",
        "default": "#F8F2E8"
      },
      {
        "type": "color",
        "id": "color_background_alt",
        "label": "Fond alterné (beige doux)",
        "default": "#F0E3CF"
      },
      {
        "type": "color",
        "id": "color_cream",
        "label": "Blanc porcelaine (cartes)",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "color_mocha",
        "label": "Mocha (boutons, couleur signature)",
        "default": "#8B6F52"
      },
      {
        "type": "color",
        "id": "color_mocha_dark",
        "label": "Mocha foncé (hover, accents)",
        "default": "#6E5540"
      },
      {
        "type": "color",
        "id": "color_chocolate",
        "label": "Chocolat profond (titres, logo, bandeau bas de page)",
        "default": "#3E2C20"
      },
      {
        "type": "color",
        "id": "color_gold",
        "label": "Or (liserés, petits accents)",
        "default": "#B08D5B"
      },
      {
        "type": "color",
        "id": "color_sage",
        "label": "Vert sauge (accent végétal, badge Éco)",
        "default": "#7C8968"
      },
      {
        "type": "color",
        "id": "color_ink",
        "label": "Texte principal",
        "default": "#3A2E24"
      },
      {
        "type": "color",
        "id": "color_ink_light",
        "label": "Texte secondaire",
        "default": "#7A6A5C"
      }
    ]
  },
  {
    "name": "Typographie",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_header_font",
        "label": "Police des titres",
        "default": "cormorant_n4"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "label": "Police du texte courant",
        "default": "jost_n4"
      }
    ]
  },
  {
    "name": "Logo & favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Largeur du logo",
        "min": 80,
        "max": 260,
        "step": 10,
        "default": 150,
        "unit": "px"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "logo_line1",
        "label": "Logo texte — petite ligne",
        "default": "Maison"
      },
      {
        "type": "text",
        "id": "logo_line2",
        "label": "Logo texte — grande ligne",
        "default": "Palma"
      },
      {
        "type": "text",
        "id": "logo_tagline",
        "label": "Signature sous le logo",
        "default": "Art de la table & réception"
      }
    ]
  },
  {
    "name": "Coordonnées & réseaux",
    "settings": [
      {
        "type": "text",
        "id": "shop_phone",
        "label": "Téléphone",
        "default": "+33 6 00 00 00 00"
      },
      {
        "type": "text",
        "id": "shop_email",
        "label": "Email de contact",
        "default": "contact@maison-palma.fr"
      },
      {
        "type": "header",
        "content": "Réseaux sociaux"
      },
      {
        "type": "text",
        "id": "social_instagram",
        "label": "Instagram (URL)"
      },
      {
        "type": "text",
        "id": "social_pinterest",
        "label": "Pinterest (URL)"
      },
      {
        "type": "text",
        "id": "social_facebook",
        "label": "Facebook (URL)"
      }
    ]
  },
  {
    "name": "Panier",
    "settings": [
      {
        "type": "select",
        "id": "cart_type",
        "label": "Type de panier",
        "default": "drawer",
        "options": [
          { "value": "drawer", "label": "Tiroir latéral" },
          { "value": "page", "label": "Page dédiée" }
        ]
      }
    ]
  }
]
