<section class="features">
  <div class="container features__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'feature' -%}
        <div class="features__item" data-reveal {{ block.shopify_attributes }}>
          <span class="features__icon">{% render 'icon', name: block.settings.icon, size: 26 %}</span>
          <p class="features__heading">{{ block.settings.heading }}</p>
          {%- if block.settings.text != blank -%}
            <p class="features__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Réassurance",
  "settings": [],
  "blocks": [
    {
      "type": "feature",
      "name": "Argument",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "vase",
          "options": [
            { "value": "vase", "label": "Vase" },
            { "value": "heart", "label": "Cœur" },
            { "value": "truck", "label": "Camion" },
            { "value": "sparkle", "label": "Étincelle" },
            { "value": "leaf", "label": "Feuille" },
            { "value": "check", "label": "Coche" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Titre", "default": "Sélectionné avec soin" },
        { "type": "textarea", "id": "text", "label": "Texte", "default": "Des pièces élégantes et intemporelles." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Réassurance",
      "blocks": [
        { "type": "feature", "settings": { "icon": "vase", "heading": "Sélectionné avec soin", "text": "Des pièces élégantes et intemporelles." } },
        { "type": "feature", "settings": { "icon": "heart", "heading": "Pour votre plus beau jour", "text": "Mariages, fiançailles et réceptions." } },
        { "type": "feature", "settings": { "icon": "map-pin", "heading": "Retrait au local", "text": "Sur rendez-vous, à Carnoules (Var)." } },
        { "type": "feature", "settings": { "icon": "sparkle", "heading": "Service sur mesure", "text": "Un accompagnement personnalisé de A à Z." } }
      ]
    }
  ]
}
{% endschema %}
