{%- if cart.item_count == 0 -%}
  <div class="cart-drawer__empty">
    <p>Votre réservation est vide pour le moment.</p>
    <a href="{{ routes.root_url }}#a-la-carte" class="button button--primary" data-cart-drawer-close>Composer ma table</a>
  </div>
{%- else -%}
  <ul class="cart-drawer__items">
    {%- for item in cart.items -%}
      <li class="cart-drawer__item">
        <a href="{{ item.url }}" class="cart-drawer__item-image">
          {%- if item.image -%}
            <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | escape }}" width="80" height="80" loading="lazy">
          {%- else -%}
            <span class="placeholder-swatch"></span>
          {%- endif -%}
        </a>
        <div class="cart-drawer__item-details">
          <a href="{{ item.url }}">{{ item.product.title }}</a>
          {%- if item.variant.title != 'Default Title' -%}
            <p class="cart-drawer__item-variant">{{ item.variant.title }}</p>
          {%- endif -%}
          <div class="cart-drawer__item-row">
            <quantity-input class="quantity-input" data-line="{{ forloop.index }}">
              <button type="button" data-cart-qty-decrease aria-label="Diminuer la quantité">{% render 'icon', name: 'minus', size: 14 %}</button>
              <input type="number" min="0" value="{{ item.quantity }}" data-cart-qty-input aria-label="Quantité" data-line="{{ forloop.index }}">
              <button type="button" data-cart-qty-increase aria-label="Augmenter la quantité">{% render 'icon', name: 'plus', size: 14 %}</button>
            </quantity-input>
            <span class="cart-drawer__item-price">{{ item.final_line_price | money }}</span>
          </div>
        </div>
        <button type="button" class="cart-drawer__item-remove" data-cart-remove data-line="{{ forloop.index }}" aria-label="Retirer">
          {% render 'icon', name: 'trash', size: 16 %}
        </button>
      </li>
    {%- endfor -%}
  </ul>
  <div class="cart-drawer__footer">
    <div class="cart-drawer__subtotal">
      <span>Sous-total</span>
      <span>{{ cart.total_price | money }}</span>
    </div>
    <p class="cart-drawer__note">Location sur devis final selon dates et quantités. Taxes et caution calculées à la validation.</p>
    <a href="{{ routes.cart_url }}" class="button button--primary button--full">Voir la réservation</a>
    <a href="{{ routes.root_url }}#devis" class="button button--ghost button--full" data-cart-drawer-close>Demander un devis personnalisé</a>
  </div>
{%- endif -%}
