<section class="hero" id="top" style="--hero-min-height: {{ section.settings.height }}px;">
  <div class="hero__media">
    {%- if section.settings.image -%}
      <img
        src="{{ section.settings.image | image_url: width: 2000 }}"
        srcset="{{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1400 }} 1400w, {{ section.settings.image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero__placeholder"></div>
    {%- endif -%}
    <div class="hero__overlay"></div>
  </div>

  <div class="hero__content container" data-reveal>
    <span class="hero__icon">{% render 'icon', name: 'leaf', size: 30 %}</span>
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    <span class="hero__divider" aria-hidden="true"></span>
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hero__actions">
      {%- if section.settings.primary_label != blank -%}
        <a href="{{ section.settings.primary_link | default: '#formules' }}" class="button button--primary">{{ section.settings.primary_label }}</a>
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        <a href="{{ section.settings.secondary_link | default: '#devis-form' }}" class="button button--outline-light">{{ section.settings.secondary_label }}</a>
      {%- endif -%}
      {%- if section.settings.tertiary_label != blank -%}
        <a href="{{ section.settings.tertiary_link | default: '#inspirations' }}" class="button button--outline-light">{{ section.settings.tertiary_label }}</a>
      {%- endif -%}
    </div>
  </div>

  <a href="#histoire" class="hero__scroll-cue" aria-label="Découvrir notre histoire">
    {% render 'icon', name: 'arrow-down', size: 22 %}
  </a>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image de fond" },
    { "type": "range", "id": "height", "label": "Hauteur", "min": 400, "max": 900, "step": 20, "unit": "px", "default": 720 },
    { "type": "text", "id": "eyebrow", "label": "Sur-titre", "default": "Location de vaisselle & art de la table" },
    { "type": "text", "id": "heading", "label": "Titre", "default": "Une table à la hauteur de votre plus beau jour" },
    { "type": "textarea", "id": "subheading", "label": "Sous-titre", "default": "Vaisselle, verrerie, couverts et décoration en location pour mariages et réceptions, dans trois formules pensées pour chaque budget." },
    { "type": "text", "id": "primary_label", "label": "Bouton principal", "default": "Découvrir nos formules" },
    { "type": "url", "id": "primary_link", "label": "Lien du bouton principal" },
    { "type": "text", "id": "secondary_label", "label": "Bouton secondaire", "default": "Demander un devis" },
    { "type": "url", "id": "secondary_link", "label": "Lien du bouton secondaire" },
    { "type": "text", "id": "tertiary_label", "label": "Bouton tertiaire", "default": "Découvrir nos inspirations" },
    { "type": "url", "id": "tertiary_link", "label": "Lien du bouton tertiaire" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
